# 서버 포트
PORT=4000

# 앱 런타임 연결
DATABASE_URL="postgresql://cold_cases:cold_cases@localhost:5434/cold_cases?schema=public"

# 마이그레이션 전용 연결
DIRECT_URL="postgresql://cold_cases:cold_cases@localhost:5434/cold_cases?schema=public"
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

SUSPECT_PHOTO_COUNTRIES=
SUSPECT_PHOTO_BASE_URL=
SHOW_DRAFTS=

# 실종자들의 정원 FBI 동기화 (기본: 켜짐, 6시간마다)
MISSING_SYNC_ENABLED=true
MISSING_SYNC_INTERVAL_HOURS=6

# 실종자들의 정원 경찰청 안전Dream Open API (safe182.go.kr 발급)
SAFE182_ESNTL_ID=
SAFE182_AUTH_KEY=

# 관리자 페이지 (/admin)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

CASE_INBOX_DIR=prisma/imports/inbox
# '사건 파일 올리기' API 키 (32자 이상, 예: openssl rand -base64 48). 배포 서버에서 새벽 사건 수집을 받을 때 씀. 비우면 꺼짐
CASE_IMPORT_TOKEN=
# pnpm cases push가 보낼 배포 서버 주소 (예: https://서버주소/api). 토큰은 서버와 같은 값
CASE_IMPORT_URL=

NEWS_SYNC_ENABLED=true
NEWS_QUERIES=
# 해외 기사(미국·영국·일본 Google 뉴스)도 모음. 제목은 원문으로 쌓이고, 관리실에서 공개할 때만 번역함
NEWS_FOREIGN_ENABLED=true
NEWS_AUTO_PUBLISH=true
# 새 뉴스로 사건 초안까지 만들지 (기본 false: 뉴스는 브리핑룸에만)
NEWS_DRAFT_CASES=false


PAPAGO_CLIENT_ID=
PAPAGO_CLIENT_SECRET=

# ── 선택 로그인 (네이버·구글) ──
USER_SESSION_SECRET=

#   Callback URL: http://localhost:3001/api/auth/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

#   승인된 리디렉션 URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

WEB_ORIGINS=http://localhost:3001
