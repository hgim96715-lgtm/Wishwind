# 서버 포트
PORT=4000

# 앱 런타임 연결
DATABASE_URL="postgresql://cold_cases:cold_cases@localhost:5434/cold_cases?schema=public"

# 마이그레이션 전용 연결
DIRECT_URL="postgresql://cold_cases:cold_cases@localhost:5434/cold_cases?schema=public"
ANTHROPIC_API_KEY=
SUSPECT_PHOTO_COUNTRIES=
SUSPECT_PHOTO_BASE_URL=
SHOW_DRAFTS=

# 실종방 FBI 동기화 (기본: 켜짐, 6시간마다)
MISSING_SYNC_ENABLED=true
MISSING_SYNC_INTERVAL_HOURS=6

# 실종방 경찰청 안전Dream Open API (safe182.go.kr 발급)
SAFE182_ESNTL_ID=
SAFE182_AUTH_KEY=

# 관리자 페이지 (/admin). 둘 다 비우면 관리자 로그인이 꺼짐
# ADMIN_PASSWORD: 12자 이상. ADMIN_SESSION_SECRET: 32자 이상 무작위 문자열 (예: openssl rand -base64 48)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# 브리핑룸 새 소식: Google 뉴스 RSS에서 기사 제목·링크를 모아 관리실에 쌓음 (기본: 켜짐, 3시간마다)
# 관리자가 공개한 기사만 브리핑룸에 보임. NEWS_QUERIES는 쉼표로 구분 (비우면 기본 검색어)
# 예약 작업이 새 사건 파일(JSON)을 넣는 폴더. API가 10분마다 비공개 초안으로 가져옴 (이미 있는 사건은 건드리지 않음)
CASE_INBOX_DIR=prisma/imports/inbox

NEWS_SYNC_ENABLED=true
NEWS_SYNC_INTERVAL_HOURS=3
NEWS_QUERIES=
# 해외 기사(미국·영국·일본 Google 뉴스)도 모음. 제목은 원문으로 쌓이고, 관리실에서 공개할 때만 번역함
NEWS_FOREIGN_ENABLED=true

# 해외 기사 제목 번역: 네이버 클라우드 Papago Translation (유료, 100만 글자 단위 과금)
# 콘솔 > AI Services > Papago Translation에서 Application 등록 후 Client ID / Client Secret
# 비우면 번역 없이 원문 제목으로 공개 (관리실에서 직접 한국어 제목을 써도 됨)
PAPAGO_CLIENT_ID=
PAPAGO_CLIENT_SECRET=
