generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Country {
  KR
  US
  JP
  CN
  GB
  OTHER
}

enum CaseCategory {
  MURDER
  MISSING
  KIDNAPPING
  SEXUAL_CRIME
  ROBBERY
  ARSON
  TERROR
  FRAUD
  OTHER
}

enum CaseStatus {
  UNSOLVED
  IN_PROGRESS
  SOLVED
}

enum DatePrecision {
  DAY
  MONTH
  YEAR
  UNKNOWN
}

enum SuspectStatus {
  SUSPECTED
  ARRESTED
  INDICTED
  CONVICTED
  ACQUITTED
  CLEARED
  DECEASED
  AT_LARGE
}

enum VictimStatus {
  DECEASED
  INJURED
  MISSING
  FOUND_ALIVE
  UNKNOWN
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum CourtLevel {
  FIRST
  APPEAL
  SUPREME
  OTHER
}

enum SentenceType {
  DEATH
  LIFE
  IMPRISONMENT
  PROBATION
  FINE
  ACQUITTAL
  OTHER
}

enum SentenceVoteChoice {
  AGREE
  DISAGREE
}

enum SentenceVoteDirection {
  TOO_LENIENT
  TOO_HARSH
}

enum UserContentStatus {
  PUBLISHED
  HELD
  BLOCKED
  HIDDEN
}

enum ModerationStage {
  REGEX
  AI
  FALLBACK
  ADMIN
}

enum ModerationVerdict {
  ALLOW
  BLOCK
  HOLD
}

enum CaseReviewStatus {
  DRAFT
  NEEDS_REVIEW
  VERIFIED
  REJECTED
}

enum SourceType {
  COURT
  GOVERNMENT
  NEWS_AGENCY
  NEWS
  BROADCAST
  OTHER
}

enum RelatedKind {
  DOCUMENTARY
  TV_PROGRAM
  YOUTUBE
  PODCAST
  MOVIE
  SERIES
  BOOK
}

enum ClaimStatus {
  UNVERIFIED
  QUOTE_MATCHED
  CONFIRMED
  CONFLICT
}

model Case {
  id    String @id @default(uuid(7)) @db.Uuid
  slug  String @unique @db.VarChar(200)
  title String @db.VarChar(200)

  summary  String  @db.VarChar(500)
  overview String? @db.Text

  victimCountNote String? @map("victim_count_note") @db.VarChar(100)

  country  Country
  category CaseCategory
  status   CaseStatus   @default(UNSOLVED)
  location String?      @db.VarChar(200)

  occurredAt          DateTime?     @map("occurred_at") @db.Date
  occurredAtPrecision DatePrecision @default(DAY) @map("occurred_at_precision")
  solvedAt            DateTime?     @map("solved_at") @db.Date

  isPublished    Boolean          @default(false) @map("is_published")
  reviewStatus   CaseReviewStatus @default(DRAFT) @map("review_status")
  reviewNote     String?          @map("review_note") @db.Text
  lastVerifiedAt DateTime?        @map("last_verified_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  timeline                TimelineEvent[]
  suspects                Suspect[]
  victims                 Victim[]
  unsolvedQuestions       UnsolvedQuestion[]
  suspiciousCircumstances SuspiciousCircumstance[]
  sources                 CaseSource[]
  userQuestions           UserQuestion[]
  missingPersons          MissingPerson[]
  briefingPosts           BriefingPost[]
  newsItems               NewsItem[]
  relatedContents         RelatedContent[]
  changes                 CaseChange[]

  @@index([isPublished, occurredAt(sort: Desc)])
  @@index([reviewStatus])
  @@index([status, occurredAt(sort: Desc)])
  @@index([country, category, occurredAt(sort: Desc)])
  @@index([category, occurredAt(sort: Desc)])
  @@map("cases")
}

model CaseSource {
  id     String @id @default(uuid(7)) @db.Uuid
  caseId String @map("case_id") @db.Uuid

  url         String     @db.VarChar(1000)
  title       String     @db.VarChar(300)
  publisher   String     @db.VarChar(200)
  type        SourceType @default(NEWS)
  publishedAt DateTime?  @map("published_at") @db.Date
  accessedAt  DateTime?  @map("accessed_at") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  case   Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  claims CaseClaim[]

  @@unique([caseId, url])
  @@map("case_sources")
}

/// 사건 뒤에 바뀐 것: 사건을 계기로 생긴 법·기념일·제도
enum ChangeKind {
  LAW
  DAY
  SYSTEM
}

/// 사건이 바꾼 것 하나 (예: 애덤월시법, 12월 6일 여성 폭력 추모의 날, 코드 애덤). 사건 페이지·홈 '알고 계셨나요?'·/changes 에 씀
model CaseChange {
  id     String @id @default(uuid(7)) @db.Uuid
  caseId String @map("case_id") @db.Uuid

  kind        ChangeKind
  name        String   @db.VarChar(200)
  year        Int?     @db.SmallInt
  /// 기념일이면 매년 돌아오는 날 (MM-DD, 예: "12-06")
  observedOn  String?  @map("observed_on") @db.VarChar(5)
  /// 법·제도가 생긴 나라. 사건 나라와 다를 수 있음
  country     Country?
  description String   @db.VarChar(500)
  sourceUrl   String   @map("source_url") @db.VarChar(1000)
  sourceTitle String   @map("source_title") @db.VarChar(300)
  sortOrder   Int      @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, name])
  @@index([observedOn])
  @@map("case_changes")
}

model RelatedContent {
  id     String @id @default(uuid(7)) @db.Uuid
  caseId String @map("case_id") @db.Uuid

  kind         RelatedKind
  title        String      @db.VarChar(300)
  platform     String      @db.VarChar(100)
  creator      String?     @db.VarChar(200)
  url          String      @db.VarChar(1000)
  releaseYear  Int?        @map("release_year") @db.SmallInt
  language     String      @default("ko") @db.VarChar(10)
  note         String?     @db.VarChar(300)
  isDramatized Boolean     @default(false) @map("is_dramatized")
  sortOrder    Int         @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, url])
  @@index([caseId, sortOrder])
  @@map("related_contents")
}

model CaseClaim {
  id       String @id @default(uuid(7)) @db.Uuid
  sourceId String @map("source_id") @db.Uuid

  field  String      @db.VarChar(100)
  value  String      @db.Text
  quote  String      @db.Text
  status ClaimStatus @default(UNVERIFIED)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  source CaseSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, field])
  @@index([status])
  @@map("case_claims")
}

model TimelineEvent {
  id     String @id @default(uuid(7)) @db.Uuid
  caseId String @map("case_id") @db.Uuid

  occurredAt          DateTime?     @map("occurred_at") @db.Timestamptz(3)
  occurredAtPrecision DatePrecision @default(DAY) @map("occurred_at_precision")
  title               String        @db.VarChar(200)
  description         String?       @db.Text

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, occurredAt, sortOrder])
  @@map("timeline_events")
}

model Suspect {
  id     String @id @default(uuid(7)) @db.Uuid
  caseId String @map("case_id") @db.Uuid

  name        String?       @db.VarChar(100)
  alias       String?       @db.VarChar(100)
  description String?       @db.Text
  charges     String?       @db.Text
  status      SuspectStatus @default(SUSPECTED)
  sortOrder   Int           @default(0) @map("sort_order")

  identityDisclosedAt      DateTime? @map("identity_disclosed_at") @db.Date
  identityDisclosureAgency String?   @map("identity_disclosure_agency") @db.VarChar(100)
  identityDisclosureSource String?   @map("identity_disclosure_source") @db.VarChar(1000)
  photoUrl                 String?   @map("photo_url") @db.VarChar(300)
  photoSourceAgency        String?   @map("photo_source_agency") @db.VarChar(100)
  photoSourceUrl           String?   @map("photo_source_url") @db.VarChar(1000)

  nameExceptionReason    String?   @map("name_exception_reason") @db.VarChar(300)
  nameExceptionDecidedAt DateTime? @map("name_exception_decided_at") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  case      Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sentences Sentence[]

  @@index([caseId, sortOrder])
  @@map("suspects")
}

model Victim {
  id     String @id @default(uuid(7)) @db.Uuid
  caseId String @map("case_id") @db.Uuid

  name        String?      @db.VarChar(100)
  alias       String?      @db.VarChar(100)
  age         Int?         @db.SmallInt
  gender      Gender       @default(UNKNOWN)
  description String?      @db.Text
  status      VictimStatus @default(UNKNOWN)
  sortOrder   Int          @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, sortOrder])
  @@map("victims")
}

model Sentence {
  id        String @id @default(uuid(7)) @db.Uuid
  suspectId String @map("suspect_id") @db.Uuid

  courtLevel CourtLevel   @default(FIRST) @map("court_level")
  courtName  String?      @map("court_name") @db.VarChar(100)
  type       SentenceType
  verdict    String?      @db.Text
  penalty    String?      @db.VarChar(200)
  isFinal    Boolean      @default(false) @map("is_final")
  decidedAt  DateTime?    @map("decided_at") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  suspect Suspect        @relation(fields: [suspectId], references: [id], onDelete: Cascade)
  votes   SentenceVote[]

  @@index([suspectId, decidedAt])
  @@map("sentences")
}

/// 확정 형량에 대한 시민 의견. 로그인이 없어 브라우저별 익명 ID(voterId)로 1인 1표를 구분함
model SentenceVote {
  id         String @id @default(uuid(7)) @db.Uuid
  sentenceId String @map("sentence_id") @db.Uuid
  voterId    String @map("voter_id") @db.Uuid

  choice    SentenceVoteChoice
  direction SentenceVoteDirection?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sentence Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)

  @@unique([sentenceId, voterId])
  @@index([sentenceId, choice])
  @@map("sentence_votes")
}

model UnsolvedQuestion {
  id     String @id @default(uuid(7)) @db.Uuid
  caseId String @map("case_id") @db.Uuid

  question    String  @db.VarChar(300)
  description String? @db.Text
  isResolved  Boolean @default(false) @map("is_resolved")
  answer      String? @db.Text
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  case        Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userAnswers UserAnswer[]

  @@index([caseId, sortOrder])
  @@map("unsolved_questions")
}

model UserAnswer {
  id         String @id @default(uuid(7)) @db.Uuid
  questionId String @map("question_id") @db.Uuid
  voterId    String @map("voter_id") @db.Uuid

  body        String            @db.VarChar(500)
  status      UserContentStatus
  reportCount Int               @default(0) @map("report_count")
  /** '공감해요' 수. 싫어요는 두지 않음 */
  empathyCount Int              @default(0) @map("empathy_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  question    UnsolvedQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reports     UserContentReport[]
  moderations UserContentModeration[]
  empathies   UserAnswerEmpathy[]

  @@unique([questionId, voterId])
  @@index([questionId, status, createdAt])
  @@index([voterId, updatedAt])
  @@index([status, updatedAt])
  @@map("user_answers")
}

/** 수사 노트 '공감해요'. 한 사람이 한 노트에 한 번만 */
model UserAnswerEmpathy {
  answerId  String   @map("answer_id") @db.Uuid
  voterId   String   @map("voter_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  answer UserAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@id([answerId, voterId])
  @@index([voterId])
  @@map("user_answer_empathies")
}

model UserQuestion {
  id      String @id @default(uuid(7)) @db.Uuid
  caseId  String @map("case_id") @db.Uuid
  voterId String @map("voter_id") @db.Uuid

  body         String            @db.VarChar(200)
  status       UserContentStatus
  reportCount  Int               @default(0) @map("report_count")
  curiousCount Int               @default(0) @map("curious_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  case        Case                    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  curious     UserQuestionCurious[]
  reports     UserContentReport[]
  moderations UserContentModeration[]

  @@unique([caseId, voterId])
  @@index([caseId, status, curiousCount(sort: Desc), createdAt(sort: Desc)])
  @@index([voterId, updatedAt])
  @@index([status, updatedAt])
  @@map("user_questions")
}

model UserQuestionCurious {
  userQuestionId String @map("user_question_id") @db.Uuid
  voterId        String @map("voter_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  userQuestion UserQuestion @relation(fields: [userQuestionId], references: [id], onDelete: Cascade)

  @@id([userQuestionId, voterId])
  @@index([voterId])
  @@map("user_question_curious")
}

model UserContentReport {
  id         String  @id @default(uuid(7)) @db.Uuid
  answerId   String? @map("answer_id") @db.Uuid
  questionId String? @map("question_id") @db.Uuid
  voterId    String  @map("voter_id") @db.Uuid

  reason String? @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  answer   UserAnswer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  question UserQuestion? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([answerId, voterId])
  @@unique([questionId, voterId])
  @@map("user_content_reports")
}

model UserContentModeration {
  id         String  @id @default(uuid(7)) @db.Uuid
  answerId   String? @map("answer_id") @db.Uuid
  questionId String? @map("question_id") @db.Uuid

  stage        ModerationStage
  verdict      ModerationVerdict
  category     String            @db.VarChar(40)
  reason       String?           @db.Text
  model        String?           @db.VarChar(100)
  inputTokens  Int               @default(0) @map("input_tokens")
  outputTokens Int               @default(0) @map("output_tokens")
  estimatedUsd Decimal           @default(0) @map("estimated_usd") @db.Decimal(10, 6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  answer   UserAnswer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  question UserQuestion? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([answerId, createdAt])
  @@index([questionId, createdAt])
  @@index([verdict, createdAt])
  @@map("user_content_moderations")
}

model SuspiciousCircumstance {
  id     String @id @default(uuid(7)) @db.Uuid
  caseId String @map("case_id") @db.Uuid

  title       String  @db.VarChar(200)
  description String? @db.Text
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, sortOrder])
  @@map("suspicious_circumstances")
}

enum MissingSource {
  FBI
  SAFE182
}

enum MissingStatus {
  ACTIVE
  INACTIVE
}

model MissingPerson {
  id         String        @id @default(uuid(7)) @db.Uuid
  source     MissingSource
  externalId String        @map("external_id") @db.VarChar(100)

  name          String    @db.VarChar(200)
  gender        Gender    @default(UNKNOWN)
  ageAtMissing  Int?      @map("age_at_missing")
  ageNow        Int?      @map("age_now")
  missingDate   DateTime? @map("missing_date") @db.Date
  lastSeenPlace String?   @map("last_seen_place") @db.VarChar(300)
  region        String    @db.VarChar(100)
  appearance    String?   @db.Text
  description   String?   @db.Text
  descriptionKo String?   @map("description_ko") @db.Text
  descriptionKoSourceHash String? @map("description_ko_source_hash") @db.VarChar(64)
  photoUrl      String?   @map("photo_url") @db.VarChar(500)
  thumbUrl      String?   @map("thumb_url") @db.VarChar(500)
  sourceUrl     String    @map("source_url") @db.VarChar(500)

  status         MissingStatus @default(ACTIVE)
  sourceModified DateTime?     @map("source_modified") @db.Timestamptz(3)
  lastSyncedAt   DateTime      @map("last_synced_at") @db.Timestamptz(3)

  caseId String? @map("case_id") @db.Uuid
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([source, externalId])
  @@index([status, region, missingDate(sort: Desc)])
  @@index([caseId])
  @@map("missing_persons")
}

model CloudMessage {
  id              String            @id @default(uuid(7)) @db.Uuid
  voterId         String            @map("voter_id") @db.Uuid
  body            String            @db.VarChar(100)
  /** 꽂은 사람이 정한 닉네임. 정원에 "○○님이 바람개비를 꽂았습니다"로 보임 (메시지와 함께 검사) */
  nickname        String?           @db.VarChar(20)
  status          UserContentStatus @default(HELD)
  category        String?           @db.VarChar(40)
  posX            Float?            @map("pos_x") @db.Real
  posZ            Float?            @map("pos_z") @db.Real
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, createdAt(sort: Desc)])
  @@index([voterId, createdAt])
  @@map("cloud_messages")
}

enum BriefingKind {
  NOTICE
  NEWS
  CASE_UPDATE
  OPINION
}

enum BriefingStatus {
  DRAFT
  PUBLISHED
}

model BriefingPost {
  id     String         @id @default(uuid(7)) @db.Uuid
  kind   BriefingKind
  status BriefingStatus @default(DRAFT)

  title    String  @db.VarChar(200)
  body     String  @db.Text
  isPinned Boolean @default(false) @map("is_pinned")

  caseId String? @map("case_id") @db.Uuid
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, publishedAt(sort: Desc)])
  @@index([status, isPinned])
  @@index([caseId])
  @@map("briefing_posts")
}

enum InquiryKind {
  QUESTION
  CORRECTION
  FEEDBACK
}

enum InquiryStatus {
  OPEN
  ANSWERED
  CLOSED
}

model Inquiry {
  id      String        @id @default(uuid(7)) @db.Uuid
  kind    InquiryKind
  status  InquiryStatus @default(OPEN)
  voterId String        @map("voter_id") @db.Uuid

  caseSlug String? @map("case_slug") @db.VarChar(200)
  body     String  @db.VarChar(2000)

  reply     String?   @db.Text
  repliedAt DateTime? @map("replied_at") @db.Timestamptz(3)
  /** 관리자가 관리실 목록에서 처음 본 때. 보기 전까지만 보낸 사람이 고칠 수 있음 */
  seenAt    DateTime? @map("seen_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([kind, status, createdAt(sort: Desc)])
  @@index([voterId, createdAt(sort: Desc)])
  @@map("inquiries")
}

model BlockedVoter {
  voterId   String   @id @map("voter_id") @db.Uuid
  reason    String?  @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("blocked_voters")
}

model PageView {
  id           String  @id @default(uuid(7)) @db.Uuid
  path         String  @db.VarChar(300)
  visitorHash  String  @map("visitor_hash") @db.VarChar(64)
  referrerHost String? @map("referrer_host") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([path, createdAt])
  @@map("page_views")
}

enum FileTarget {
  CASE
  MISSING
}

enum FileEventKind {
  VIEW
  SHARE
}

/** 사건 파일·실종자 카드를 연 사람, 공유한 사람 수. 방문자 해시는 날마다 바뀌어 하루 1회만 셈 */
model FileEvent {
  id          String        @id @default(uuid(7)) @db.Uuid
  target      FileTarget
  targetKey   String        @map("target_key") @db.VarChar(100)
  kind        FileEventKind
  channel     String?       @db.VarChar(20)
  visitorHash String        @map("visitor_hash") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([target, targetKey, kind, visitorHash])
  @@index([target, targetKey, kind, createdAt])
  @@map("file_events")
}

enum NewsStatus {
  NEW
  PUBLISHED
  DISMISSED
}

enum NewsAutoVerdict {
  PUBLISH
  HOLD
  DISMISS
}

model NewsItem {
  id        String     @id @default(uuid(7)) @db.Uuid
  url       String     @unique @db.VarChar(1000)
  title     String     @db.VarChar(300)
  publisher String     @db.VarChar(200)
  query     String     @db.VarChar(100)
  status    NewsStatus @default(NEW)

  region  String  @default("KR") @db.VarChar(10)
  lang    String  @default("ko") @db.VarChar(10)
  titleKo String? @map("title_ko") @db.VarChar(300)

  autoVerdict NewsAutoVerdict? @map("auto_verdict")
  autoReason  String?          @map("auto_reason") @db.VarChar(300)

  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz(3)

  caseId String? @map("case_id") @db.Uuid
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, region, publishedAt(sort: Desc)])
  @@index([caseId])
  @@map("news_items")
}

enum AuthProvider {
  NAVER
  GOOGLE
}

model User {
  id          String    @id @default(uuid(7)) @db.Uuid
  voterId     String    @unique @map("voter_id") @db.Uuid
  /** 사이트에서 쓰는 닉네임 (네이버·구글 이름을 받지 않고 직접 정함). 없으면 "바람 N" */
  nickname    String?   @unique @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastLoginAt DateTime  @default(now()) @map("last_login_at") @db.Timestamptz(3)

  accounts UserAccount[]

  @@map("users")
}

model UserAccount {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id") @db.VarChar(200)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("user_accounts")
}
